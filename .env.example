NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Drive yedekleme ─────────────────────────────────────────────────
# Google Cloud Console → OAuth istemcisi (Web). Yetkili yönlendirme URI ile GOOGLE_REDIRECT_URI birebir aynı olmalı.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://stok.marssoft.com.tr/api/backup/google/callback
# Refresh token şifreleme anahtarı (32 bayt):  openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=
# Vercel Cron çağrılarını doğrular (rastgele uzun değer)
CRON_SECRET=
# Storage bucket listesi (yol düzeni: <bucket>/<tenant_id>/...)
BACKUP_DOCUMENT_BUCKETS=documents,product-images,invoices
